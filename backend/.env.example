# ---------------------------------------------------------------------------
# Optional local overrides for the API (backend/.env). All settings are optional:
# with no .env the app runs on free local SQLite with live OpenStreetMap and
# Open-Meteo data and no API keys. See ../.env.example for the full deploy list.
# ---------------------------------------------------------------------------

# --- security ---------------------------------------------------------------
# Leave unset for local development. Set a long random value before exposing the
# API: any deployment that keeps the default secret can have its tokens forged.
# JWT_SECRET_KEY=replace-with-a-long-random-secret
# APP_ENV=development
# ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- database ---------------------------------------------------------------
# Relative sqlite paths resolve against backend/, never the shell's directory.
# DATABASE_URL=sqlite:///./citypulse.db

# --- live free signals ------------------------------------------------------
# ENABLE_LIVE_DATA=true
# OVERPASS_ENABLED=true
# CITYPULSE_USER_AGENT=CityPulse/2.0 (your-contact-here)

# --- civic engine -----------------------------------------------------------
# CLUSTER_RADIUS_METERS=180

# --- demos ------------------------------------------------------------------
# Set to false to start with an empty database.
# SEED_DEMO_DATA=true
# DEMO_PASSWORD=password123

# --- frontend hosting -------------------------------------------------------
# Serve frontend/dist from this process (a single-container deployment).
# SERVE_FRONTEND=true
