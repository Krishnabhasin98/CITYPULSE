# ---------------------------------------------------------------------------
# CityPulse deployment settings — copy to `.env` and edit.
#
#     cp .env.example .env
#
# Everything is optional except JWT_SECRET_KEY, which docker-compose requires.
# With no .env at all the app still runs locally on SQLite with live OpenStreetMap
# and Open-Meteo data (no API keys anywhere).
# ---------------------------------------------------------------------------

# --- security ---------------------------------------------------------------
# Required by docker-compose. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-long-random-secret

# development | production. In production the one-click demo sign-in returns 404.
APP_ENV=production

# How long a login stays valid. Default is 7 days.
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- storage ----------------------------------------------------------------
# Inside Docker the volume /data holds all mutable state.
DATABASE_URL=sqlite:////data/citypulse.db
UPLOAD_DIR=/data/uploads
CITYPULSE_CACHE_DIR=/data/cache

# Any SQLAlchemy URL works (e.g. postgresql+psycopg://user:pass@host/db).
# When pointing at a real database server, set this too:
# DB_POOL_PRE_PING=true

# --- networking -------------------------------------------------------------
CITYPULSE_PORT=8000
# Only needed when the UI is served from a different origin than the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- live, key-free external signals ---------------------------------------
ENABLE_LIVE_DATA=true
OVERPASS_ENABLED=true
# Nominatim requires a descriptive User-Agent with real contact info. Example
# domains get HTTP 403, so use something identifying before public traffic.
CITYPULSE_USER_AGENT=CityPulse/2.0 (self-hosted civic reporting)
CITYPULSE_HTTP_TIMEOUT=6
NOMINATIM_URL=https://nominatim.openstreetmap.org
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
OVERPASS_URL=https://overpass-api.de/api/interpreter
CITYPULSE_CACHE_ENABLED=true
CITYPULSE_GEOCODE_TTL=2592000
CITYPULSE_WEATHER_TTL=1200

# --- civic engine -----------------------------------------------------------
# Radius within which two reports about the same spot become one incident.
CLUSTER_RADIUS_METERS=180
AREA_RADIUS_METERS=1500

# --- background work --------------------------------------------------------
ENABLE_SCHEDULER=true
SCHEDULER_INTERVAL_SECONDS=300

# --- seeding & demos --------------------------------------------------------
SEED_DEMO_DATA=true
DEMO_PASSWORD=password123

# --- logging ----------------------------------------------------------------
LOG_LEVEL=INFO
SQL_ECHO=false
